# ignitenet-proxy configuration.
# Copy to .env (local dev) or feed these as a systemd EnvironmentFile.
# Real environment variables always override values from .env.

# --- Required ---
# IgniteNet device web login.
USERNAME=root
PASSWORD=

# --- HTTP server ---
LISTEN=:8881

# --- Dial mode ---
# DIRECT=1 dials devices directly (use on a host that already reaches them).
# Unset/0 tunnels over SSH via JUMP_ADDR.
DIRECT=0

# --- SSH tunnel (required unless DIRECT=1) ---
JUMP_ADDR=jump-host.example:22
JUMP_USER=root
SSH_KEY=~/.ssh/id_rsa

# --- RSSI aggregation defaults (/rssi probes these interfaces) ---
WIFI_IFACES=ath0,ath1
METRO_IFACES=wlan0
